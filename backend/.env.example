# InSight Backend Environment Configuration

# Production Database (Neon PostgreSQL with pgvector):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local / CI Testing Database (SQLite fallback, defaults to ./insight_dev.db if unset):
DATABASE_URL=sqlite:///./insight_dev.db
USE_DB_STORAGE=True
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Neon Auth / Better Auth (Optional)
# NEON_AUTH_URL=https://...
# NEON_JWKS_URL=https://...
