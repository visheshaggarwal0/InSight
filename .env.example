# ==============================================================================
# InSight — Environment Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
REQUIRE_AUTH=false
DATABASE_URL=sqlite:///./insight_dev.db

# ==============================================================================
# Microsoft Power BI Service & Azure Entra ID Embedded Integration
# (App-Owns-Data Service Principal Architecture for Microsoft Hackathon)
# ==============================================================================

# 1. Microsoft Entra ID (Azure Active Directory) Tenant ID
# Found in: Azure Portal -> Microsoft Entra ID -> Overview -> Directory (tenant) ID
POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000

# 2. Azure App Registration Application (Client) ID
# Found in: Azure Portal -> Microsoft Entra ID -> App registrations -> Your App -> Application (client) ID
POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# 3. Azure App Registration Client Secret Value
# Found in: Azure Portal -> App registrations -> Your App -> Certificates & secrets -> Client secrets -> Value
POWERBI_CLIENT_SECRET=your_azure_client_secret_value_here

# 4. Target Power BI Workspace ID (Group ID)
# Found in: Power BI Service URL (app.powerbi.com/groups/<WORKSPACE_ID>/...)
POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# 5. Target Power BI Report ID
# Found in: Power BI Service URL (app.powerbi.com/groups/<WORKSPACE_ID>/reports/<REPORT_ID>/...)
POWERBI_REPORT_ID=00000000-0000-0000-0000-000000000000

# 6. Target Power BI Dataset / Semantic Model ID (Optional but recommended for automated refresh)
# Found in: Power BI Service URL (app.powerbi.com/groups/<WORKSPACE_ID>/datasets/<DATASET_ID>/...)
POWERBI_DATASET_ID=00000000-0000-0000-0000-000000000000

# Advanced Power BI Cloud Endpoints (Default Commercial Cloud)
POWERBI_AUTHORITY_URL=https://login.microsoftonline.com
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default
POWERBI_API_URL=https://api.powerbi.com/v1.0/myorg
